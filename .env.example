# ===========================================
# Reverse Roadmap - 环境变量配置模板
# ===========================================

# ===========================================
# 应用基础配置
# ===========================================

# 运行环境 (development | production)
NODE_ENV=production

# ===========================================
# 后端 API 配置
# ===========================================

# API 服务端口
PORT=3001

# MongoDB 连接字符串
# 请替换为你的实际数据库连接字符串
MONGODB_URI="your_mongodb_connection_string_here"

# ===========================================
# 前端应用配置
# ===========================================

# API 基础 URL (前端调用后端 API 的地址)
# Next.js 环境变量必须以 NEXT_PUBLIC_ 开头才能在客户端访问
NEXT_PUBLIC_RR_API=""

# Toggle Mode
NEXT_PUBLIC_TOGGLE_MODE=toggle-mode-string
