# ===========================================
# Reverse Roadmap - Docker Environment Variables
# ===========================================

# ===========================================
# Application Configuration
# ===========================================

# Node Environment
NODE_ENV=development

# ===========================================
# API Service Configuration
# ===========================================

# API Port
API_PORT=

# MongoDB Connection String
MONGODB_URI=

# ===========================================
# RAG Service Configuration
# ===========================================

# RAG Service Port
RAG_PORT=

# PostgreSQL connection string for RAG service
DATABASE_URL=

# DeepSeek API Key
DEEPSEEK_API_KEY=

# ===========================================
# Web Application Configuration
# ===========================================

# Web Application Port
WEB_PORT=

# API Base URL (for frontend to call backend API)
NEXT_PUBLIC_RR_API=

# ===========================================
# MongoDB Configuration
# ===========================================

# MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Database Name
MONGO_DB_NAME=