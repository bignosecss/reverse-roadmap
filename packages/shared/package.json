{
  "name": "@repo/shared",
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dto": {
      "import": "./dist/types/dto/index.mjs",
      "require": "./dist/types/dto/index.js"
    },
    "./models": {
      "import": "./dist/types/models/index.mjs",
      "require": "./dist/types/models/index.js"
    },
    "./flow": {
      "import": "./dist/types/flow/index.mjs",
      "require": "./dist/types/flow/index.js"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@xyflow/react": "^12.8.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
